# Copy to .env before running Bun scripts. Dotenvx injects these values.
POSTGRES_PORT=5432
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# Integration tests use local PostgreSQL and clean up their own rows.
TEST_DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# Public app origin. The API, Better Auth and webhooks live under /api on it.
APP_ORIGIN=http://localhost:3000
VITE_APP_ORIGIN=http://localhost:3000
VITE_WEB_ORIGIN=http://localhost:3000
# Local-only starter secret. Generate a new 32+ character value for deployment.
BETTER_AUTH_SECRET=local-only-better-auth-secret-1234567890
LOG_LEVEL=info
# Optional seed target: register account first, then set its email.
SEED_USER_EMAIL=
# Optional Resend email delivery. Both values required to enable verification and reset mail.
RESEND_API_KEY=
EMAIL_FROM=
# Optional QStash jobs. Set all three, or QSTASH_DEV=true to run the local dev server.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_DEV=
# Optional Upstash Redis credentials. Leave both blank for PostgreSQL-only setup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_NAMESPACE=seattrue:dev
# Optional Stripe billing: secret key + webhook secret together. Prices resolve by lookup key (bun run stripe:seed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Billing portal configuration printed by bun run stripe:seed (live: bpc_1UXGFQEmKiht8PXgdUn9Lalf).
STRIPE_PORTAL_CONFIG_ID=

# Optional Google sign-in (Workspace accounts only). Leave both empty to hide it.
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google (local)
# and https://<your-domain>/api/auth/callback/google (production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public marketing domain used for canonical URLs, sitemap, RSS, llms.txt and JSON-LD.
SITE_URL=https://seattrue.com
