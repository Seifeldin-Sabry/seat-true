{
  "name": "seattrue",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenvx run -f .env -- turbo dev --filter=@seattrue/app",
    "build": "dotenvx run -f .env -- turbo build",
    "start": "NODE_ENV=production dotenvx run -f .env -- bun run --no-env-file --cwd apps/app start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck",
    "test": "dotenvx run -f .env -- turbo test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "dotenvx run -f .env -- turbo db:generate --filter=@seattrue/db",
    "db:migrate": "dotenvx run -f .env -- turbo db:migrate --filter=@seattrue/db",
    "db:seed": "dotenvx run -f .env -- turbo db:seed --filter=@seattrue/db",
    "db:studio": "dotenvx run -f .env -- turbo db:studio --filter=@seattrue/db",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "secrets:set": "dotenvx set -f .env.production --no-native",
    "secrets:fly": "bun scripts/fly-secrets.ts",
    "stripe:seed": "dotenvx run -f .env -- bun scripts/stripe-seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@dotenvx/dotenvx": "2.31.1",
    "stripe": "22.6.2",
    "turbo": "2.11.4",
    "typescript": "5.9.3",
    "@seattrue/billing": "workspace:*"
  }
}
