{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["bunfig.toml", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".tanstack/**"]
    },
    "@seattrue/app#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".tanstack/**"],
      "env": ["APP_ORIGIN", "VITE_APP_ORIGIN", "VITE_WEB_ORIGIN", "SITE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@seattrue/app#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "APP_ORIGIN",
        "BETTER_AUTH_SECRET",
        "LOG_LEVEL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "QSTASH_TOKEN",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "QSTASH_DEV",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "REDIS_KEY_NAMESPACE",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PORTAL_CONFIG_ID",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "PLATFORM_ADMIN_EMAILS",
        "VITE_APP_ORIGIN",
        "VITE_WEB_ORIGIN",
        "SITE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "APP_ORIGIN",
        "BETTER_AUTH_SECRET",
        "LOG_LEVEL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "QSTASH_TOKEN",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "QSTASH_DEV",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PORTAL_CONFIG_ID",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "PLATFORM_ADMIN_EMAILS"
      ]
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL", "SEED_USER_EMAIL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    }
  },
  "globalPassThroughEnv": ["FLY_APP_NAME"]
}
