# Tests only: local docker compose PostgreSQL (start Colima, then `bun run db:up`).
# Non-secret values; committed in plain text on purpose. Never point tests at Neon.
DATABASE_URL=postgres://starter:starter@localhost:5433/starter
TEST_DATABASE_URL=postgres://starter:starter@localhost:5433/starter
API_ORIGIN=http://localhost:3001
APP_ORIGIN=http://localhost:3000
VITE_API_ORIGIN=http://localhost:3001
VITE_APP_ORIGIN=http://localhost:3000
VITE_WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=local-only-better-auth-secret-1234567890
LOG_LEVEL=silent
